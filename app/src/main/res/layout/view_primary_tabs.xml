<?xml version="1.0" encoding="utf-8"?>
<HorizontalScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_glass_card"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:padding="8dp"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/tabCoreButton"
            style="@style/Widget.App.Button.Tab"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tab_core" />

        <View
            android:layout_width="6dp"
            android:layout_height="match_parent" />

        <Button
            android:id="@+id/tabAutomationButton"
            style="@style/Widget.App.Button.Tab"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tab_automation" />

        <View
            android:layout_width="6dp"
            android:layout_height="match_parent" />

        <Button
            android:id="@+id/tabProfileButton"
            style="@style/Widget.App.Button.Tab"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tab_profile" />
    </LinearLayout>
</HorizontalScrollView>
