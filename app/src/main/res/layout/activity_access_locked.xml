<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_gradient"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="28dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_glass_card"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                style="@style/Widget.App.ScreenBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/lock_badge" />

            <TextView
                android:id="@+id/lockTitleLabel"
                style="@style/Widget.App.ScreenTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/lock_unknown_title" />

            <TextView
                android:id="@+id/lockMessageLabel"
                style="@style/Widget.App.ScreenSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/lock_unknown_message" />

            <TextView
                android:id="@+id/lockDetailsLabel"
                style="@style/Widget.App.SectionBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/lock_contact_admin_hint" />

            <Button
                android:id="@+id/refreshAccessButton"
                style="@style/Widget.App.Button.Glossy"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/lock_refresh_button" />

            <Button
                android:id="@+id/signOutButton"
                style="@style/Widget.App.Button.Ghost"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/logout_button" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
